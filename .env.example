# ── Supabase (obligatorio) ─────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA la expongas en el frontend. Necesaria para el webhook de Stripe.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (enlaces de email y redirecciones de Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (opcional: sin esto los pagos aparecen como "no disponibles") ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
